    "group.detail.owner.cannotLeave": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The group owner cannot leave directly. Transfer ownership from the member list to someone whose iCloud mapping is complete; you then become an administrator and can leave. The iCloud share itself stays with the Apple Account that created it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "群組擁有者不能直接退出。請先從成員清單將擁有權移轉給另一位已完成 iCloud 對應的成員，移轉後你會成為管理員並可以退出。iCloud 共享本身仍由建立共享的 Apple Account 管理。"
          }
        }
      }
    },
