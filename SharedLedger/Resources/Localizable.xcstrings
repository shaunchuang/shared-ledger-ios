    "notification.category.groupInvitation.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify me when someone joins, leaves, or is invited to one of my groups."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有人加入、離開或被邀請進入你的群組時通知。"
          }
        }
      }
    },
    "notification.category.groupInvitation.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group invitations and member changes"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "群組邀請與成員異動"
          }
        }
      }
    },
    "notification.category.settlementReminder.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remind me when a book still has money I owe or am owed, or when another member records or reverses a settlement."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在某個帳本還有未結清的應付或應收款項，或其他成員記錄、撤銷結算時提醒。"
          }
        }
      }
    },
    "notification.category.settlementReminder.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settlement reminders"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "待結算提醒"
          }
        }
      }
    },
    "notification.category.transactionChange.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify me when another member adds, edits, or voids a transaction. Your own changes never notify you."
          }
        },
