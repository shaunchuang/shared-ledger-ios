    "notification.settings.appUsable.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are only reminders. Recording, syncing, settling, and exporting never need notification permission. With them off, all of your data and features stay intact, and member changes are still kept in full in the group's audit log."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知只是提醒。記帳、同步、結算與匯出都不需要通知權限，關閉後所有帳務資料與功能都不受影響，成員的異動仍然會完整保留在群組的稽核紀錄裡。"
          }
        }
      }
    },
    "notification.settings.appUsable.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app works fully without notifications"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不開通知也能完整使用"
          }
        }
      }
    },
    "notification.settings.categories.footer.allDisabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every type is off, so you will not receive any notifications."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有種類都關閉了，目前不會收到任何通知。"
          }
