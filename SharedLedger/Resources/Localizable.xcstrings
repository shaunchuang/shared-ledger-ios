      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting removes the data itself, not just hides it. Consider exporting a CSV copy first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除會移除資料本身，不只是隱藏。刪除前建議先到「匯出資料」保留一份 CSV。"
