    "member.confirm.leave.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving keeps the payments and splits you are already part of. Rejoining needs a new invitation from an administrator."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "退出後會保留你既有的付款與分攤歷史。重新加入必須由管理者重新邀請。"
          }
        }
      }
    },
