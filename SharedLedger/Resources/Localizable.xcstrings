    "privacy.local.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No ledger data is deleted and nobody you share with is affected. You will be asked again which member you are the next time you open a shared group, and notification preferences return to their defaults."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳務資料不會被刪除，其他成員也不受影響。下次開啟共享群組時需要重新確認自己是哪一位成員，通知偏好會回到預設值。"
          }
        }
      }
    },
    "privacy.local.confirm.title": {
