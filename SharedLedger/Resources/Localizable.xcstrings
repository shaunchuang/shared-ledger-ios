    "notification.authorization.denied.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications for this app are turned off in Settings, so no reminders will be sent. Recording, syncing, and settling are unaffected."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個 App 的通知在系統設定裡是關閉的，因此不會送出任何提醒。記帳、同步與結算都不受影響。"
          }
        }
      }
    },
    "notification.authorization.denied.title": {
      "extractionState": "manual",
      "localizations": {
