        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking your iCloud account status. You can keep recording in the meantime — everything is saved on this device."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在確認 iCloud 帳號狀態。這段期間仍可正常記帳，資料會保存在本機。"
