    "member.identity.inactive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have left this group or were removed from it. An administrator has to reactivate your original membership and invite you again; creating another member to work around the removal is not allowed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已離開或被移出這個群組。請由群組管理者重新啟用原本的成員身分並重新邀請，不能直接建立另一個新成員繞過移除狀態。"
          }
        }
      }
    },
    "member.identity.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So that payers, splits and permissions are right, confirm which member you are in “%@”. Your current-user mapping is kept only in your private iCloud; the app separately stores the participant identifier for this share to check sharing permissions."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了讓付款人、分攤與權限正確，請確認你在「%@」中的成員身分。你的目前使用者對應只保存在私人 iCloud；系統另外保存這個 share 專用的 participant 識別，用來核對共享權限。"
          }
        }
      }
    },
