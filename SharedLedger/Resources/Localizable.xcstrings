    },
    "category.defaults.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse food, clothing, housing, transport, education, leisure, taxes, everyday supplies, healthcare, insurance, childcare, care, pets, and financial fees. Expand a category or search for a detail."
