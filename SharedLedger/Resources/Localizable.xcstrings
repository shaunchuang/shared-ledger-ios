          "stringUnit": {
            "state": "translated",
            "value": "封存「%@」"
          }
        }
      }
    },
    "account.archive.confirmMessage.keepsHistory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every past transaction and balance adjustment is kept and nothing is deleted."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有歷史交易與餘額調整都會保留，不會被刪除。"
          }
        }
      }
    },
    "account.archive.confirmMessage.plain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once archived it no longer appears in the account picker for new transactions."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封存後不會再出現在新增交易的帳戶選單中。"
          }
        }
      }
    },
    "account.archive.confirmMessage.withHistory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account already has transactions or balance adjustments; archiving keeps all of that history."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個帳戶已有交易或餘額調整，封存後仍會保留完整歷史。"
          }
        }
      }
    },
    "account.archive.confirmTitle": {
