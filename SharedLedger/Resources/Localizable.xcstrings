    "account.adjustment.section.balance.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A separate adjustment entry is added for the difference; existing transactions are never rewritten or deleted."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統會新增一筆差額調整，不會改寫或刪除既有交易。"
          }
        }
      }
    },
