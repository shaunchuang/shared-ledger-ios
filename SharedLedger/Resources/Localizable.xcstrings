    "participant.explanation.unmapped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This member is not mapped to an iCloud share participant yet. The mapping is created once they accept the invitation and confirm who they are."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這位成員還沒有對應到 iCloud 共享參與者。對方接受邀請並確認身分後才會建立對應。"
          }
        }
      }
    },
    "participant.explanation.writable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
