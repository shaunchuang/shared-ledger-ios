        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在「%2$@」重新送出了成員邀請。"
          }
        }
      }
    },
    "notification.body.member.invitationRevoked": {
      "extractionState": "manual",
      "localizations": {
