    "category.defaults.impact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds missing categories by name and parent. Existing categories and transactions are not renamed, moved or deleted. New categories are enabled in active books; existing disabled choices stay unchanged. Use a category’s action button to add more subcategories."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只補入缺少的同名、同層分類，不會改名、搬移或刪除既有分類與交易。新增分類會套用到啟用中的帳本；既有停用設定維持不變。可以再從分類旁的「⋯」新增子分類。"
          }
        }
      }
    },
    "category.defaults.installed": {
      "extractionState": "manual",
      "localizations": {
