    "member.confirm.remove.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” stops being an active member in the app, but their payment and split history is kept. Confirm separately that their iCloud sharing access is removed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」會停止成為有效 App 成員，但歷史付款與分攤仍會保留。請另外確認 iCloud 共享存取權已移除。"
          }
        }
      }
    },
    "member.confirm.remove.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the member?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除成員？"
          }
        }
      }
    },
    "member.confirm.revoke.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoke"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回"
          }
        }
      }
    },
    "member.confirm.revoke.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This revokes the app invitation for “%@”. Any iCloud share already created still needs its access confirmed in the system sharing screen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將撤回「%@」的 App 邀請狀態。已產生的 iCloud 分享仍需在系統共享畫面確認存取權。"
          }
        }
      }
    },
    "member.confirm.revoke.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoke the invitation?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回邀請？"
          }
        }
      }
    },
    "member.confirm.transferOwnership.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移轉"
          }
        }
      }
    },
    "member.confirm.transferOwnership.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” becomes the new group owner and you become an administrator. The iCloud share list stays with the Apple Account that created the share and does not transfer with it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」會成為新的群組擁有者，你會改為管理員。iCloud 共享名單仍由建立共享的 Apple Account 管理，不會一併移轉。"
          }
        }
      }
    },
    "member.confirm.transferOwnership.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer group ownership?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移轉群組擁有權？"
          }
        }
      }
