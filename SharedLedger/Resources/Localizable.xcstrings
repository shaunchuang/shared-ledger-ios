    "category.defaults.accountingHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a transfer when moving money between your own accounts or paying a credit card bill to avoid recording the same purchase twice."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自己帳戶間移轉、繳信用卡款時請使用轉帳，避免把同一筆消費重複記為支出。"
          }
        }
      }
    },
    "category.defaults.current": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default categories are up to date"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設分類已齊全"
          }
