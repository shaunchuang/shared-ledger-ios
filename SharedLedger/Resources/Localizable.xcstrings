    "settlement.skipped.notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld transaction has payment or split data that has not finished syncing and is left out for now. It is recalculated once iCloud catches up."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld transactions have payment or split data that has not finished syncing and are left out for now. They are recalculated once iCloud catches up."
                }
              }
            }
          }
        },
        "zh-Hant": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "有 %lld 筆交易的付款或分攤資料尚未同步完成，已暫時不列入結算。等 iCloud 同步完成後會自動重新計算。"
                }
              }
            }
          }
        }
      }
    },
    "settlement.suggestions.settled": {
