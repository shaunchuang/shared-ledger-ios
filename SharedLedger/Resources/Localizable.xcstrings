    "sync.conflict.action.cleanup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove superseded rows"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除被取代的明細"
          }
        }
      }
    },
    "sync.conflict.cleanup.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing only deletes the payment and split rows that no longer count. Amounts, reports and settlement stay exactly as they are. You can also leave it: the app clears them itself once a transaction has been unchanged for a day."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除只會刪掉已經不算數的那一版付款與分攤，金額、報表與結算結果都不會改變。不清除也可以，交易滿一天沒有變動後 App 會自己清掉。"
          }
        }
      }
    },
    "sync.conflict.error.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not remove"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法清除"
          }
        }
      }
    },
    "sync.conflict.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the same transaction is edited on two devices at once, the app keeps the version that synced last and lists the affected transactions here."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一筆交易在兩台裝置上被同時編輯時，App 會採用最後同步到的那一版，並把受影響的交易列在這裡。"
          }
        }
      }
    },
    "sync.conflict.reason.mismatched": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its payment or split totals do not add up to the transaction amount, so it stays out of settlement until you edit it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "付款或分攤合計和交易金額對不起來，這筆交易暫時不會計入結算，請重新編輯一次。"
          }
        }
      }
    },
    "sync.conflict.reason.missingDetails": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its payment and split rows still have not arrived from iCloud, so it stays out of settlement for now."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "付款與分攤明細遲遲沒有從 iCloud 同步過來，這筆交易暫時不會計入結算。"
          }
        }
      }
    },
    "sync.conflict.reason.superseded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This transaction still carries payment and split rows from another version. The amounts and settlement you see already use the current version only."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這筆交易還留著另一版的付款與分攤紀錄。畫面上的金額與結算已經只採用目前這一版。"
          }
        }
      }
    },
    "sync.conflict.section": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data conflicts"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料衝突"
          }
        }
      }
    },
    "sync.error.network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach iCloud. Check your network connection and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到 iCloud，請確認網路後再試。"
          }
        }
      }
    },
    "sync.error.notAuthenticated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are not signed in to iCloud. Check your sign-in status under Settings → Apple Account."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 尚未完成登入，請到「設定 → Apple 帳號」確認登入狀態。"
          }
        }
      }
    },
    "sync.error.permission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You do not have write access to this shared data. Check the sharing settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有這筆共享資料的寫入權限，請確認分享設定。"
          }
        }
      }
    },
    "sync.error.quotaExceeded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iCloud storage is full. Free up space and sync again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 儲存空間不足，請釋出空間後再同步。"
          }
        }
      }
    },
    "sync.error.serviceBusy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is busy. This will retry automatically."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 服務忙碌中，稍後會自動重試。"
          }
        }
      }
    },
    "sync.row.accessibilityLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Sync, %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同步，%@"
          }
        }
      }
    },
    "sync.state.failed.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last sync did not finish. Everything is still saved on this device. iCloud retries automatically, and you can also check again yourself.\n\nReason: %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一次同步沒有完成，資料仍完整保存在本機。iCloud 會自動重試，你也可以手動重新檢查。\n\n原因：%@"
          }
        }
      }
    },
    "sync.state.failed.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync failed"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步失敗"
          }
        }
      }
    },
    "sync.state.offline.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no network connection right now. Everything is saved on this device and you can keep recording; it syncs automatically once you are back online, with nothing to re-enter."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有網路連線。帳務完整保存在本機，可以繼續記帳；恢復連線後會自動同步，不需要重新輸入。"
          }
        }
      }
    },
    "sync.state.offline.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離線"
          }
        }
      }
    },
    "sync.state.restricted.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is disabled for this Apple Account by parental controls or device management. You can still record everything on this device, but nothing will sync or be shared."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個 Apple 帳號的 iCloud 被家長控制或裝置管理停用。帳務仍可正常記錄在本機，但無法同步或共享。"
          }
        }
      }
    },
    "sync.state.restricted.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is restricted"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 受到限制"
          }
        }
      }
    },
    "sync.state.signedOut.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is not signed in to iCloud. Your records stay on this device and are not shared with other members. Sign in under Settings → Apple Account and turn on iCloud Drive to start syncing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置尚未登入 iCloud，帳務只會保存在本機，也不會與其他成員共享。到「設定 → Apple 帳號」登入並開啟 iCloud 雲碟後就會開始同步。"
          }
        }
      }
    },
    "sync.state.signedOut.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not signed in to iCloud"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未登入 iCloud"
          }
        }
      }
    },
    "sync.state.syncing.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncing with iCloud. You can keep recording in the meantime."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在與 iCloud 同步。這段期間仍可正常記帳。"
          }
        }
      }
    },
    "sync.state.syncing.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncing"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步中"
          }
        }
      }
    },
    "sync.state.undetermined.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
