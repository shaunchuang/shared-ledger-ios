    "notification.body.settlement.recorded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ recorded a settlement in “%2$@”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在「%2$@」記錄了一筆結算。"
          }
        }
      }
    },
    "notification.body.settlement.reversed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ reversed a settlement in “%2$@”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 撤銷了「%2$@」的一筆結算。"
          }
        }
      }
    },
    "notification.body.settlementReminder.both": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%3$lld payment in “%2$@” of “%1$@” is still unsettled."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%3$lld payments in “%2$@” of “%1$@” are still unsettled."
                }
              }
            }
          }
        },
        "zh-Hant": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "「%1$@」的「%2$@」還有 %3$lld 筆款項尚未結清。"
                }
              }
            }
          }
        }
      }
    },
    "notification.body.settlementReminder.owed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%3$lld payment in “%2$@” of “%1$@” has not been paid to you yet."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%3$lld payments in “%2$@” of “%1$@” have not been paid to you yet."
                }
              }
            }
          }
        },
        "zh-Hant": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "「%1$@」的「%2$@」還有 %3$lld 筆款項尚未付給你。"
                }
              }
            }
          }
        }
      }
    },
    "notification.body.settlementReminder.owes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "You still owe %3$lld payment in “%2$@” of “%1$@”."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "You still owe %3$lld payments in “%2$@” of “%1$@”."
                }
              }
            }
          }
        },
        "zh-Hant": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "你在「%1$@」的「%2$@」還有 %3$lld 筆應付款項尚未結清。"
                }
              }
            }
          }
        }
      }
    },
