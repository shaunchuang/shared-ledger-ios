    "member.confirm.transferOwnership.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” becomes the new group owner and you become an administrator. The iCloud share list stays with the Apple Account that created the share and does not transfer with it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」會成為新的群組擁有者，你會改為管理員。iCloud 共享名單仍由建立共享的 Apple Account 管理，不會一併移轉。"
          }
        }
      }
    },
