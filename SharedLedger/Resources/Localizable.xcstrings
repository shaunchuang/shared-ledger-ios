    },
    "phone.onboarding.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a group and book to start tracking. Use it on your own, or invite family and friends later."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先建立群組與帳本，就能開始記帳。你可以自己使用，也可以稍後邀請家人或朋友。"
          }
        }
