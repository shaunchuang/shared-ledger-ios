    "privacy.footer.affectsOthers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This group already has other members. The data lives in your iCloud, so deleting it takes the whole group's records away from everyone who joined. This cannot be undone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個群組已經有其他成員。資料存放在你的 iCloud，刪除會讓所有已加入的成員同時失去這個群組的全部帳務，且無法復原。"
          }
        }
      }
    },
    "privacy.footer.leaveInstead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To leave, go to Group management, pick this group, then Members. Your past records stay in the group so the others can still reconcile."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "退出群組的入口在「群組管理」→ 選擇這個群組 → 成員管理。退出後你的歷史帳務仍會保留在群組裡，供其他成員對帳。"
          }
        }
      }
    },
    "privacy.footer.ownGroup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting removes every book, account, category, transaction, settlement and audit record in this group, and cannot be undone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除會移除這個群組的所有帳本、帳戶、分類、交易、結算與稽核紀錄，且無法復原。"
          }
        }
      }
    },
    "privacy.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting removes the data itself, not just hides it. Consider exporting a CSV copy first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除會移除資料本身，不只是隱藏。刪除前建議先到「匯出資料」保留一份 CSV。"
          }
        }
      }
    },
