    "notification.authorization.authorized.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders can be sent. Choose which ones you want below."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以送出提醒。下方可以逐項決定要收哪些通知。"
          }
        }
      }
    },
    "notification.authorization.authorized.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are on"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已開啟"
          }
        }
      }
    },
    "notification.authorization.denied.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications for this app are turned off in Settings, so no reminders will be sent. Recording, syncing, and settling are unaffected."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個 App 的通知在系統設定裡是關閉的，因此不會送出任何提醒。記帳、同步與結算都不受影響。"
          }
        }
      }
    },
    "notification.authorization.denied.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off in Settings"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統已關閉通知"
          }
        }
      }
    },
    "notification.authorization.notDetermined.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have not been asked for notification permission yet. The app works fully without it — you will just need to open the app to see what members changed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒詢問過通知權限。不開啟也可以完整使用 App，只是成員的異動要自己進來看。"
          }
        }
      }
    },
    "notification.authorization.notDetermined.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are not on yet"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未開啟通知"
          }
        }
      }
    },
    "notification.authorization.provisional.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications go straight to Notification Center without a sound or banner."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知會直接進入通知中心，不會發出聲音或橫幅。"
          }
        }
      }
    },
    "notification.authorization.provisional.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivering quietly"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安靜遞送中"
          }
        }
      }
    },
    "notification.authorization.unavailable.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The notification permission status cannot be read right now, so notifications are paused. Recording and syncing are unaffected."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前查不到通知授權狀態，通知會暫時停送。記帳與同步不受影響。"
          }
        }
      }
    },
    "notification.authorization.unavailable.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification status unavailable"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認通知狀態"
          }
        }
      }
    },
    "notification.body.group.ownershipTransferred": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The owner of “%1$@” has changed."
