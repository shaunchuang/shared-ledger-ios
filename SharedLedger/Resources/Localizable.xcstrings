          "stringUnit": {
            "state": "translated",
            "value": "%1$@ revoked a member invitation in “%2$@”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 撤回了「%2$@」的一則成員邀請。"
          }
        }
      }
    },
    "notification.body.member.left": {
      "extractionState": "manual",
      "localizations": {
