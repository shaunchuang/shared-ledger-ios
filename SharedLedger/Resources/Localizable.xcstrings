    "notification.authorization.authorized.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders can be sent. Choose which ones you want below."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以送出提醒。下方可以逐項決定要收哪些通知。"
          }
        }
      }
    },
    "notification.authorization.authorized.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are on"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已開啟"
          }
        }
      }
    },
    "notification.authorization.denied.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications for this app are turned off in Settings, so no reminders will be sent. Recording, syncing, and settling are unaffected."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個 App 的通知在系統設定裡是關閉的，因此不會送出任何提醒。記帳、同步與結算都不受影響。"
          }
        }
      }
    },
    "notification.authorization.denied.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off in Settings"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統已關閉通知"
          }
        }
      }
    },
    "notification.authorization.notDetermined.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have not been asked for notification permission yet. The app works fully without it — you will just need to open the app to see what members changed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒詢問過通知權限。不開啟也可以完整使用 App，只是成員的異動要自己進來看。"
          }
        }
      }
    },
    "notification.authorization.notDetermined.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are not on yet"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未開啟通知"
          }
        }
      }
    },
    "notification.authorization.provisional.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications go straight to Notification Center without a sound or banner."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知會直接進入通知中心，不會發出聲音或橫幅。"
          }
        }
      }
    },
    "notification.authorization.provisional.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivering quietly"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安靜遞送中"
          }
        }
      }
    },
    "notification.authorization.unavailable.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The notification permission status cannot be read right now, so notifications are paused. Recording and syncing are unaffected."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前查不到通知授權狀態，通知會暫時停送。記帳與同步不受影響。"
          }
        }
      }
    },
    "notification.authorization.unavailable.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification status unavailable"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認通知狀態"
          }
        }
      }
    },
    "notification.body.group.ownershipTransferred": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The owner of “%1$@” has changed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」的擁有者已變更。"
          }
        }
      }
    },
    "notification.body.member.identityConfirmed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ joined the group “%2$@”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已加入群組「%2$@」。"
          }
        }
      }
    },
    "notification.body.member.invitationResent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ resent a member invitation in “%2$@”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在「%2$@」重新送出了成員邀請。"
          }
        }
      }
    },
    "notification.body.member.invitationRevoked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ revoked a member invitation in “%2$@”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 撤回了「%2$@」的一則成員邀請。"
          }
        }
      }
    },
    "notification.body.member.left": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ left the group “%2$@”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已離開群組「%2$@」。"
          }
        }
      }
    },
    "notification.body.member.removed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ changed the member list of “%2$@”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 調整了「%2$@」的成員名單。"
          }
        }
      }
    },
    "notification.body.settlement.recorded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ recorded a settlement in “%2$@”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在「%2$@」記錄了一筆結算。"
          }
        }
      }
    },
    "notification.body.settlement.reversed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ reversed a settlement in “%2$@”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 撤銷了「%2$@」的一筆結算。"
          }
        }
      }
    },
    "notification.body.settlementReminder.both": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%3$lld payment in “%2$@” of “%1$@” is still unsettled."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%3$lld payments in “%2$@” of “%1$@” are still unsettled."
                }
              }
            }
          }
        },
        "zh-Hant": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "「%1$@」的「%2$@」還有 %3$lld 筆款項尚未結清。"
                }
              }
            }
          }
        }
      }
    },
    "notification.body.settlementReminder.owed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%3$lld payment in “%2$@” of “%1$@” has not been paid to you yet."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%3$lld payments in “%2$@” of “%1$@” have not been paid to you yet."
                }
              }
            }
          }
        },
        "zh-Hant": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "「%1$@」的「%2$@」還有 %3$lld 筆款項尚未付給你。"
                }
              }
            }
          }
        }
      }
    },
    "notification.body.settlementReminder.owes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "You still owe %3$lld payment in “%2$@” of “%1$@”."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "You still owe %3$lld payments in “%2$@” of “%1$@”."
                }
              }
            }
          }
        },
        "zh-Hant": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "你在「%1$@」的「%2$@」還有 %3$lld 筆應付款項尚未結清。"
                }
              }
            }
          }
        }
      }
    },
    "notification.body.transaction.created": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ added a transaction in “%2$@”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在「%2$@」新增了一筆交易。"
          }
        }
      }
    },
    "notification.body.transaction.updated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ edited a transaction in “%2$@”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 修改了「%2$@」的一筆交易。"
          }
        }
      }
    },
    "notification.body.transaction.voided": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ voided a transaction in “%2$@”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 作廢了「%2$@」的一筆交易。"
          }
        }
      }
    },
    "notification.category.groupInvitation.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify me when someone joins, leaves, or is invited to one of my groups."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有人加入、離開或被邀請進入你的群組時通知。"
          }
        }
      }
    },
    "notification.category.groupInvitation.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group invitations and member changes"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "群組邀請與成員異動"
          }
        }
      }
    },
    "notification.category.settlementReminder.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remind me when a book still has money I owe or am owed, or when another member records or reverses a settlement."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在某個帳本還有未結清的應付或應收款項，或其他成員記錄、撤銷結算時提醒。"
          }
        }
      }
    },
    "notification.category.settlementReminder.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settlement reminders"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "待結算提醒"
          }
        }
      }
    },
    "notification.category.transactionChange.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify me when another member adds, edits, or voids a transaction. Your own changes never notify you."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他成員新增、修改或作廢交易時通知；你自己的操作不會通知。"
          }
        }
      }
    },
    "notification.category.transactionChange.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaction changes"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交易修改"
          }
        }
      }
    },
    "notification.row.accessibilityLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications, %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知，%@"
          }
        }
      }
    },
    "notification.row.summary.allOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All off"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全部關閉"
          }
        }
      }
    },
    "notification.row.summary.allOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All on"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全部開啟"
          }
        }
      }
    },
    "notification.row.summary.partial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld type on"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld types on"
                }
              }
            }
          }
        },
        "zh-Hant": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "已開啟 %lld 項"
                }
              }
            }
          }
        }
      }
    },
    "notification.settings.appUsable.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are only reminders. Recording, syncing, settling, and exporting never need notification permission. With them off, all of your data and features stay intact, and member changes are still kept in full in the group's audit log."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知只是提醒。記帳、同步、結算與匯出都不需要通知權限，關閉後所有帳務資料與功能都不受影響，成員的異動仍然會完整保留在群組的稽核紀錄裡。"
          }
        }
      }
    },
    "notification.settings.appUsable.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app works fully without notifications"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不開通知也能完整使用"
          }
        }
      }
    },
    "notification.settings.categories.footer.allDisabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every type is off, so you will not receive any notifications."
          }
        },
        "zh-Hant": {
          "stringUnit": {
