            "value": "Mapped to a read-only iCloud share participant, so their write access in the app is read-only too."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對應到唯讀的 iCloud 共享參與者，在 App 中的寫入權限會一併降為唯讀。"
          }
        }
      }
    },
    "participant.explanation.shareOwner": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapped to the iCloud share owner, who has full write access."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對應到 iCloud 共享的擁有者，具備完整寫入權限。"
          }
        }
      }
    },
    "participant.explanation.shareUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This group's iCloud share data has not arrived yet; connect to the network and let it sync."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未取得這個群組的 iCloud 共享資料，請連上網路等待同步完成。"
          }
