    "privacy.local.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This data never leaves this device: which member you are in each shared group, your notification preferences and what has already been delivered, and the iCloud write permission last resolved for each group."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些資料只存在這台裝置：共享群組裡「我是哪一位成員」的對應、通知偏好與已送出的通知紀錄，以及每個群組最後一次確認到的 iCloud 寫入權限。"
          }
        }
      }
    },
